# ============================================
# ManageCharge - Variables de Entorno
# ============================================

# Aplicación
APP_NAME=ManageCharge
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3001

# Base de Datos (MongoDB URI con autenticación)
# Usa el mismo usuario y contraseña de la sección Docker
MONGODB_URI=mongodb://USUARIO:CONTRASEÑA@localhost:27017/managecharge?authSource=admin

# JWT
JWT_SECRET=tu-super-secreto-seguro-de-32-caracteres-minimo
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# OAuth - Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/apple/callback

# Email (SendGrid)
MAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
MAIL_FROM_EMAIL=noreply@managecharge.com
MAIL_FROM_NAME=ManageCharge

# WhatsApp (Opcional)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Almacenamiento de archivos
# Opciones: local, s3, cloudinary
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Stripe
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta
# Secreto de firma de webhooks (empieza con whsec_). Obligatorio en producción.
# - Local: lo imprime `stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe`
# - Producción: Dashboard → Developers → Webhooks → tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret
PLATFORM_FEE_PERCENT=0

# Habilitar/deshabilitar automatización
# true = activo, false = deshabilitado (útil para desarrollo)
SUBSCRIPTION_AUTO_CHARGE_ENABLED=false
SUBSCRIPTION_AUTO_DOWNGRADE_ENABLED=false

# Período de gracia después del vencimiento (días)
SUBSCRIPTION_GRACE_PERIOD_DAYS=15

# Cantidad de intentos de cobro (deprecated)
#SUBSCRIPTION_RETRY_MAX_ATTEMPTS=7

# Días de la gracia en que se intenta cobrar (día 1 = vencimiento).
# Máximo un intento por día, entre 8am y 8pm hora local del tenant.
# El número de intentos es la cantidad de días de esta lista.
# Reglas: enteros, ascendentes, sin repetir, entre 1 y los días de gracia.
SUBSCRIPTION_RETRY_SCHEDULE_DAYS=1,2,4,6,9,12,15

# Cada cuánto revisa el sistema los cobros pendientes
# Formato: segundos minutos horas días meses días-semana
# Default: cada hora - 0 0 * * * *
# Testing 1 minuto - 0 */1 * * * *
# Testing 30 segundos - */30 * * * * *
SUBSCRIPTION_RETRY_CRON=0 0 * * * *

# ====================================
# DOCKER (requerido por docker-compose.yml)
# ====================================
# Se usan para crear el usuario DB la PRIMERA vez que se inicia el contenedor
# pero docker compose las exige siempre para iniciar desde terminal.
MONGO_ROOT_USERNAME=managecharge_admin
MONGO_ROOT_PASSWORD=cambia-esta-contraseña
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=cambia-esta-contraseña

# ====================================
# SEED DEL SUPER ADMIN (npm run seed:super-admin)
# ====================================
# Borra SUPER_ADMIN_PASSWORD de tu .env después de ejecutar el seed.
SUPER_ADMIN_EMAIL=admin@managecharge.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=Nombre
SUPER_ADMIN_LAST_NAME=Apellido