# ============================================
# ManageCharge - Variables de Entorno
# ============================================

# Aplicación
NODE_ENV=development
PORT=3000
APP_NAME=ManageCharge
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3001

# Base de Datos (MongoDB)
# Credenciales que usa docker-compose.yml para crear el contenedor
MONGO_ROOT_USERNAME=managecharge_admin
MONGO_ROOT_PASSWORD=cambia-esta-contraseña
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=cambia-esta-contraseña

# Si usas el contenedor de docker-compose, la URI debe incluir las credenciales:
# mongodb://USUARIO:CONTRASEÑA@localhost:27017/managecharge?authSource=admin
MONGODB_URI=mongodb://localhost:27017/managecharge

# Seed del primer Super Admin (npm run seed:super-admin)
# Borra SUPER_ADMIN_PASSWORD de tu .env después de ejecutar el seed.
SUPER_ADMIN_EMAIL=admin@managecharge.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=August
SUPER_ADMIN_LAST_NAME=Admin

# JWT
JWT_SECRET=tu-super-secreto-seguro-de-32-caracteres-minimo
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# OAuth - Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email (SendGrid)
MAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
MAIL_FROM_EMAIL=noreply@managecharge.com
MAIL_FROM_NAME=ManageCharge

# WhatsApp (Opcional)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Stripe (Opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=5